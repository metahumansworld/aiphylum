# build output
/bin/

# artefacts of the make targets — deterministic, regenerated on demand
demo-trace.jsonl
imported-trace.jsonl
sim-trace.jsonl
town-trace.jsonl
town-mind-trace.jsonl
fair-trace.jsonl
demo-stderr.log

# the record of a live run, which is none of those things: not deterministic,
# not regenerated, and not recoverable once gone. Ignored so it is never
# committed, and deliberately absent from `make clean`.
live-trace.jsonl

# episode state
*.db
*.sqlite

# macOS Finder
.DS_Store
# SQLite writes these next to any open database; they are process state, not data.
*.db-shm
*.db-wal
